# === NormoScan ENV ===

# App
APP_ENV=development
SECRET_KEY=change-me-super-secret
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501

# Database: postgres or sqlite (default sqlite for dev)
DATABASE_URL=sqlite:///./normoscan.db
# DATABASE_URL=postgresql+psycopg://normoscan:normoscan@postgres:5432/normoscan

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Vector DB: qdrant | milvus | memory (dev fallback)
VECTOR_DB=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
MILVUS_URI=http://localhost:19530

# VLM
VLM_MODEL=google/gemma-3-12b-it
# fallback: Qwen/Qwen2-VL-7B-Instruct, google/gemma-3-4b-it
VLM_QUANTIZATION=awq-4bit
VLM_ENGINE=mock
# Для vLLM / OpenAI-совместимого API укажите URL и ключ:
# VLM_ENGINE=vllm  → VLM_API_URL=http://localhost:8001/v1  (локальный vLLM)
# VLM_ENGINE=openai → VLM_API_URL=https://api.openai.com/v1  + VLM_API_KEY
VLM_API_URL=
VLM_API_KEY=
VLM_DEVICE=cuda
MAX_CONTEXT_WINDOW=8192
IMAGE_WIDTH=768
VRAM_LIMIT_GB=16
EMPTY_CACHE_AFTER_PAGE=true
MAX_CONCURRENT_VLM=1

# OCR
OCR_ENGINE=easyocr
# easyocr | paddleocr | mock

# Storage
STORAGE_PATH=./storage
GOSTS_PATH=./storage/gosts
GALLERY_PATH=./storage/gallery

# Auth / RBAC
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
KOSEVEN_ENABLED=false
KOSEVEN_DB_DSN=
KOSEVEN_TABLE=koseven_users

# MCP
MCP_ENABLED=true

# CORS
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
